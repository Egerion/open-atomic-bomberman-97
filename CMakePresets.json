{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 (MSVC + vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "windows-fetch",
      "displayName": "Windows x64 (MSVC, SDL3 via FetchContent - no vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-fetch",
      "cacheVariables": {
        "BOMBER_FETCH_SDL3": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (GCC/Clang, SDL3 via FetchContent - no vcpkg)",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BOMBER_FETCH_SDL3": "ON"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Clang, SDL3 via FetchContent - no vcpkg)",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BOMBER_FETCH_SDL3": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless (no SDL, tools only)",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "BOMBER_BUILD_VIEWER": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-fetch", "configurePreset": "windows-fetch", "configuration": "Release" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "headless", "configurePreset": "headless" }
  ]
}
