build/
dist/
out/
.vs/
.idea/
.cache/
*.user
CMakeUserPresets.json

# Per-machine setup. gamedir.txt points at YOUR Atomic Bomberman install (see
# README "Requirements"); the runtime .ini files are written by the game itself.
gamedir.txt
options.ini
nodename.ini

# Claude Code's local scratch: agent worktrees are full checkouts and this tree
# has reached multiple GB. Never committable.
.claude/

# Never commit original Atomic Bomberman assets (Interplay/Konami property).
# The engine reads them from your own game install (see README).
DATA/
*.ANI
*.RSS
*.PCX
*.SCH
extracted/

# Reverse-engineering working material — facts only live in docs/re/*.md.
# The binary, IDA database, and decompiler output stay out of the repo.
*.exe
*.EXE
*.idb
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
pseudo.c

# The 1:1 native transliteration project (native/) is DERIVED from the
# binary's decompilation — it lives on disk for local work and as the
# behavioural oracle for the clean-room port, but is never committed
# (same policy as pseudo.c itself).
native/
